#!/bin/sh
set -eu
# Git runs pre-commit from the repository root. Inspect the index, not working files.
for executable in python python3 py; do
    if command -v "$executable" >/dev/null 2>&1 && \
       "$executable" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "$executable" tools/check_sensitive.py --staged
    fi
done
echo 'Commit blocked: Python 3.10+ is required for the sensitive-information check.' >&2
exit 1
