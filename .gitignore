# Gradle / Android build output
.gradle/
.kotlin/
**/build/

# Python verification tooling cache
**/__pycache__/
*.py[cod]

# IDE and local machine state
.idea/
*.iml
local.properties

# Local tooling / assistant state (may leak local paths)
.claude/
CLAUDE.md

# Keys, signing material and local secrets
*.jks
*.keystore
keystore.properties
secrets.properties
.env
.env.*

# Ad-hoc screenshots / UI layout dumps (may contain identity and location data)
/artifacts/
# Public verification artifacts belong under ignored build/reports/.

# Detailed local documentation (not published)
docs/*
!docs/OFFICIAL_API_COVERAGE_PLAN.md
!docs/SDK_AUTHENTICATION.md
!docs/official-api-mappings.csv
!docs/PROJECT_AUDIT.md
!docs/REPOSITORY_HYGIENE.md
!docs/DEMO_ARCHITECTURE.md

# OS files
.DS_Store
Thumbs.db
